# cafe-backend.service —— 咖啡机器人后端（kiosk_server）systemd 单元（TASK 30）
#
# 功能：开机自启点单屏后台 + 制作后端（cafe_fsm 子进程由 kiosk_server 自行 fork）。
#
# ★ 部署路径约定：本文件假设仓库部署在板端 /home/rock/rv1126b（rock 为板端用户）。
#   若实际路径/用户不同，改三处：User、WorkingDirectory、ExecStart 中的绝对路径。
#   用户 VM 上的路径（如 /home/applejennie/rv1126b）只用于开发，不要在 VM 上 enable 本服务。
#
# 安装：sudo cp deploy/cafe-backend.service /etc/systemd/system/ && sudo systemctl daemon-reload
# 启用：sudo systemctl enable --now cafe-backend
# 详见 deploy/README.md。

[Unit]
Description=RV1126B Coffee Robot Backend (kiosk_server + cafe_fsm)
Documentation=https://github.com/AppleJennie/rv1126b-coffee
# 等网络就绪再启动：WiFi 插座控制（Tasmota/Sonoff）依赖局域网；
# After 排序 + Wants 拉入 network-online.target（需 NetworkManager-wait-online
# 或 systemd-networkd-wait-online 已 enable，否则该 target 不阻塞，仅作排序）。
After=network-online.target
Wants=network-online.target
# 连续崩溃防风暴（StartLimit* 属 [Unit] 段，systemd ≥230）
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# 板端运行用户。Buildroot 镜像若无 rock 用户，改成 root 或实际部署用户。
User=rock
# 仓库根目录。kiosk_server.py 内部路径均基于 __file__ 解析（不依赖 cwd），
# 但 --scenario 等相对参数与排障时生成/读取的临时文件以 cwd 为准，故显式设定。
WorkingDirectory=/home/rock/rv1126b
# Python 输出不缓冲：journal 里能实时看到 [kiosk]/[FSM] 日志行。
Environment=PYTHONUNBUFFERED=1
# 网络就绪兜底等待（默认路由出现为止，最多 60s；超时仍继续启动——
# 服务绑定 0.0.0.0 不依赖外网，插座离线由健康检查 fail-closed 拦截订单，
# 见 docs/SAFETY_INTERLOCK.md §7）。读 /proc/net/route 第二列（Destination）
# 为 00000000 即默认路由；全程无嵌套引号转义，不依赖 iproute2/awk。
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 60 ]; do grep -Eq "^[a-z0-9]+[[:space:]]+00000000[[:space:]]" /proc/net/route 2>/dev/null && exit 0; sleep 1; i=$((i+1)); done; echo cafe-backend: 60s 未等到默认路由，离线启动; exit 0'
# 模式说明：
#   --mode SIM     全模拟（无硬件演示/冒烟；板端首启建议先用它验证服务本身）
#   --mode HYBRID  混合模式：设备真/假由 projects/coffee_fsm/config.json devices 段决定
#   --mode REAL    全真硬件（需先完成 teach 位姿与手眼标定，见 docs/02-项目规划.md）
# 端口默认 8080；改端口同步改 deploy/README.md 与 docs/WIFI_DEPLOYMENT.md 的示例。
ExecStart=/usr/bin/python3 /home/rock/rv1126b/projects/kiosk_server/kiosk_server.py --host 0.0.0.0 --port 8080 --mode HYBRID
# 失败自动重启；连续崩溃防风暴的 StartLimit* 在 [Unit] 段。
Restart=on-failure
RestartSec=5
# 优雅停机：kiosk 收到 SIGTERM 退出；超时 10s 未退则强杀。
TimeoutStopSec=10
# 日志进 journal：journalctl -u cafe-backend
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cafe-backend

[Install]
WantedBy=multi-user.target
